# Copy to .env and fill in before `docker compose up --build`

APP_ENV=production
WEB_PORT=8080

POSTGRES_USER=expenses
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=expenses

SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false

MAIL_BACKEND=stub
# For real email:
# MAIL_BACKEND=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_TLS=true

# Web OAuth client ID (public; not a secret). Do not put GOCSPX client secrets in the repo.
GOOGLE_CLIENT_ID=58304476274-je7ea6s4rc3a7ajl7o0u0hdlgrgdnhju.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=58304476274-je7ea6s4rc3a7ajl7o0u0hdlgrgdnhju.apps.googleusercontent.com

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
